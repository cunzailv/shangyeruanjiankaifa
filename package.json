{
  "name": "dsh-business-planner",
  "version": "0.2.0",
  "description": "DSH 插件：左侧栏「规划大管家」工作台 + 7 阶段项目规划 Skill，装完即可 /project-development-planner 调用",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "skill",
    "project-planning",
    "saas"
  ],
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "SKILL.md",
    "README.md",
    "LICENSE",
    "references",
    "assets"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "icon": "./icon.svg",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cunzailv/shangyeruanjiankaifa.git"
  },
  "homepage": "https://github.com/cunzailv/shangyeruanjiankaifa#readme",
  "bugs": {
    "url": "https://github.com/cunzailv/shangyeruanjiankaifa/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "test": "node test/smoke.mjs",
    "prepublishOnly": "node test/smoke.mjs"
  }
}
